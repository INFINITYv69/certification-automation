{
  "version": 2,
  "functions": {
    "server.js": {
      "includeFiles": "templates/certificate_template.html"
    }
  },
  "env": {
    "AWS_LAMBDA_JS_RUNTIME": "nodejs20.x"
  },
  "routes": [
    {
      "src": "/generate",
      "dest": "server.js"
    },
    {
      "src": "/(.*)",
      "dest": "public/$1"
    }
  ]
}
